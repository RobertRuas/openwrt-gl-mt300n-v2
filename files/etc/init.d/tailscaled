#!/bin/sh /etc/rc.common
# tailscaled - daemon do Tailscale gerenciado pelo procd.
#
# Diferença em relação ao firmware original: o tailscaled NÃO é mais iniciado
# com start-stop-daemon dentro do install.sh. Aqui ele é uma instância procd,
# com respawn, e o estado fica em FLASH (/etc/tailscale) para sobreviver a
# reboot sem exigir novo login.

START=99
STOP=10
USE_PROCD=1

BIN=/tmp/opt/bin/tailscaled
STATE=/etc/tailscale
SOCK=/var/run/tailscale/tailscaled.sock
PORT=41641

start_service() {
	if [ ! -x "$BIN" ]; then
		logger -t tailscaled "binário ausente (pendrive não montado?) - aguardando"
		return 0
	fi

	mkdir -p "$STATE" /var/run/tailscale
	chmod 700 "$STATE"

	procd_open_instance
	procd_set_param command "$BIN" \
		--state="$STATE/tailscaled.state" \
		--socket="$SOCK" \
		--port="$PORT" \
		--tun=tailscale0
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t tailscaled "parando"
}

service_triggers() {
	procd_add_reload_trigger tailscale
}

reload_service() {
	stop
	start
}